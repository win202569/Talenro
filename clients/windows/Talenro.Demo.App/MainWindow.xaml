<Window x:Class="Talenro.Demo.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Talenro">
  <Grid x:Name="Root" Background="{StaticResource DemoBackground}" RequestedTheme="Light">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="24,12" Background="#DDF1ED"><TextBlock x:Name="OfflineNotice" x:Uid="OfflineNotice" TextWrapping="Wrap"/></Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="Sidebar" Width="220" Padding="20" Spacing="12">
        <TextBlock Text="Talenro" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,24"/>
        <Button x:Name="NavConnection" x:Uid="NavConnection" Tag="Connection" Click="Navigate_Click"/>
        <Button x:Name="NavNodes" x:Uid="NavNodes" Tag="Nodes" Click="Navigate_Click"/>
        <Button x:Name="NavTraffic" x:Uid="NavTraffic" Click="Placeholder_Click"/>
        <Button x:Name="NavDevices" x:Uid="NavDevices" Click="Placeholder_Click"/>
        <Button x:Name="NavAccount" x:Uid="NavAccount" Tag="Account" Click="Navigate_Click"/>
        <Button x:Name="NavSettings" x:Uid="NavSettings" Click="Placeholder_Click"/>
      </StackPanel>
      <ContentControl x:Name="PageHost" Grid.Column="1" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
    <TextBlock x:Name="Notice" Grid.Row="2" Margin="24,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</Window>
