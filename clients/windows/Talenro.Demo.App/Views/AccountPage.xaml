<Page x:Class="Talenro.Demo.App.Views.AccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="40" Spacing="20" MaxWidth="820">
    <TextBlock x:Name="AccountHeading" x:Uid="AccountHeading" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="demo@example.com" FlowDirection="LeftToRight" FontSize="20"/>
    <TextBlock x:Name="MockPlan" x:Uid="MockPlan" FontSize="22"/>
    <TextBlock x:Name="EntitlementValue" TextWrapping="Wrap"/>
    <TextBlock x:Name="UsageHeading" x:Uid="UsageHeading"/>
    <TextBlock x:Name="UsageValue" x:Uid="UsageUnavailable" FontSize="28" TextWrapping="Wrap"/>
    <TextBlock x:Name="DevicesHeading" x:Uid="DevicesHeading"/>
    <TextBlock x:Name="DevicesValue" TextWrapping="Wrap"/>
    <Button x:Name="MfaButton" x:Uid="Mfa" Click="Placeholder_Click"/>
    <Button x:Name="DevicesButton" x:Uid="Devices" Click="Placeholder_Click"/>
    <Button x:Name="LanguageButton" x:Uid="Language" Click="Placeholder_Click"/>
    <Button x:Name="DeleteButton" x:Uid="Delete" Click="Placeholder_Click"/>
    <Button x:Name="ExitDemoButton" x:Uid="ExitDemo" Click="Logout_Click"/>
  </StackPanel></ScrollViewer>
</Page>
