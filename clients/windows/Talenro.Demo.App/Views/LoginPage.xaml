<Page x:Class="Talenro.Demo.App.Views.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="LoginGeometryScroll"><StackPanel x:Name="LoginGeometryPanel" MaxWidth="460" Padding="32" Spacing="20" HorizontalAlignment="Center">
    <TextBlock Text="Talenro" FontSize="36" FontWeight="SemiBold" Margin="0,48,0,12"/>
    <TextBlock x:Name="LoginHeading" x:Uid="LoginHeading" FontSize="26" TextWrapping="Wrap"/>
    <TextBlock x:Name="EmailLabel" x:Uid="EmailLabel"/>
    <TextBlock x:Name="DemoEmail" Text="demo@example.com" FlowDirection="LeftToRight" FontSize="18"/>
    <TextBlock x:Name="PasswordLabel" x:Uid="PasswordLabel"/>
    <TextBlock x:Name="DemoPassword" Text="••••••••" FontSize="18"/>
    <Button x:Name="EnterDemoButton" x:Uid="EnterDemo" Style="{StaticResource DemoPrimaryButton}" Click="EnterDemo_Click"/>
    <Button x:Name="ResetPassword" x:Uid="ResetPassword" Click="Placeholder_Click"/>
    <Button x:Name="RegisterAccount" x:Uid="RegisterAccount" Click="Placeholder_Click"/>
    <StackPanel Spacing="12" Margin="0,28,0,0">
      <TextBlock x:Name="DemoScenarios" x:Uid="DemoScenarios" FontWeight="SemiBold"/>
      <ComboBox x:Name="LoginScenario" x:Uid="LoginScenario" SelectionChanged="Scenario_Changed" HorizontalAlignment="Stretch">
        <ComboBoxItem x:Name="ScenarioNormal" x:Uid="ScenarioNormal" Tag="Normal" IsSelected="True"/>
        <ComboBoxItem x:Name="ScenarioInvalid" x:Uid="ScenarioInvalid" Tag="Invalid"/>
        <ComboBoxItem x:Name="ScenarioSubmitting" x:Uid="ScenarioSubmitting" Tag="Submitting"/>
        <ComboBoxItem x:Name="ScenarioRejected" x:Uid="ScenarioRejected" Tag="Rejected"/>
        <ComboBoxItem x:Name="ScenarioUnavailable" x:Uid="ScenarioUnavailable" Tag="Unavailable"/>
        <ComboBoxItem x:Name="ScenarioMfa" x:Uid="ScenarioMfa" Tag="Mfa"/>
      </ComboBox>
      <TextBlock x:Name="ScenarioNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
  </StackPanel></ScrollViewer>
</Page>
