<Page x:Class="Talenro.Demo.App.Views.NodesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="18">
    <TextBlock x:Uid="NodesHeading" FontSize="28" FontWeight="SemiBold"/>
    <TextBox x:Name="SearchBox" x:Uid="NodeSearch" TextChanged="Search_Changed"/>
    <TextBlock x:Name="ProtocolHeading" x:Uid="ProtocolHeading" FontWeight="SemiBold"/>
    <TextBlock x:Name="ListStateNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <ListView x:Name="NodeList" SelectionMode="Single" SelectionChanged="Node_Selected" MaxHeight="440"/>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="BackButton" x:Uid="Back" Click="Back_Click"/>
      <Button x:Name="ApplyNodeButton" x:Uid="ApplyNode" Style="{StaticResource DemoPrimaryButton}" Click="Apply_Click"/>
    </StackPanel>
    <TextBlock x:Uid="DemoScenarios" FontWeight="SemiBold"/>
    <ComboBox x:Name="ListScenario" x:Uid="ListScenario" SelectionChanged="ListScenario_Changed">
      <ComboBoxItem x:Uid="ScenarioNormal" Tag="Ready" IsSelected="True"/>
      <ComboBoxItem x:Uid="ScenarioLoading" Tag="Loading"/>
      <ComboBoxItem x:Uid="ScenarioUnavailable" Tag="Unavailable"/>
      <ComboBoxItem x:Uid="ScenarioEmpty" Tag="Empty"/>
    </ComboBox>
  </StackPanel></ScrollViewer>
</Page>
