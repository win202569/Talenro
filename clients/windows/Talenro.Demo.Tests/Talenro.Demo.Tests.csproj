<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Talenro.Demo.App/ViewModels/NoticeFormatter.cs" Link="AppLogic/NoticeFormatter.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Talenro.Demo.App/**/*.xaml" Exclude="../Talenro.Demo.App/obj/**;../Talenro.Demo.App/bin/**" Link="AppSources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
