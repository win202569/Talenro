<Project>
  <PropertyGroup>
    <EnableLayoutDiagnostics Condition="'$(EnableLayoutDiagnostics)' == ''">false</EnableLayoutDiagnostics>
    <EnableCloseStageRecording Condition="'$(EnableCloseStageRecording)' == ''">false</EnableCloseStageRecording>
    <EnableEmailGeometryRecording Condition="'$(EnableEmailGeometryRecording)' == ''">false</EnableEmailGeometryRecording>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Talenro.Demo.App' And '$(EnableLayoutDiagnostics)' == 'true'">
    <BaseIntermediateOutputPath>obj/layout-diagnostics/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/layout-diagnostics/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>bin/layout-diagnostics/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Talenro.Demo.App' And '$(EnableCloseStageRecording)' == 'true'">
    <BaseIntermediateOutputPath>obj/close-stage-recording/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/close-stage-recording/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>bin/close-stage-recording/</BaseOutputPath>
  </PropertyGroup>
  <!-- App-only verification copies: absolute NuGet imports, no Core path overrides. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Talenro.Demo.App' And '$(EnableCloseStageRecording)' != 'true' And (('$(CloseStageVerificationMode)' == 'ordinary' And '$(EnableLayoutDiagnostics)' == 'false') Or ('$(CloseStageVerificationMode)' == 'layout' And '$(EnableLayoutDiagnostics)' == 'true'))">
    <BaseIntermediateOutputPath>obj/close-stage-verification/$(CloseStageVerificationMode)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/close-stage-verification/$(CloseStageVerificationMode)/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>bin/close-stage-verification/$(CloseStageVerificationMode)/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Talenro.Demo.App' And '$(EnableEmailGeometryRecording)' == 'true'">
    <BaseIntermediateOutputPath>obj/email-geometry/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/email-geometry/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>bin/email-geometry/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Talenro.Demo.App' And '$(EmailGeometryBuildVariant)' == 'account-center'">
    <BaseIntermediateOutputPath>obj/email-geometry-account-center/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/email-geometry-account-center/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>bin/email-geometry-account-center/</BaseOutputPath>
  </PropertyGroup>
</Project>
