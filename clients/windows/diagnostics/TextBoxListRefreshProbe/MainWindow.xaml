<Window x:Class="TextBoxListRefreshProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBox list refresh diagnostic prototype">
  <Grid Padding="32" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBox x:Name="ProbeInput" Header="Diagnostic input"
             PlaceholderText="jp-1" TextChanged="Input_Changed" />
    <ListView x:Name="ProbeRows" Grid.Row="1" SelectionMode="None" />
  </Grid>
</Window>
